# .gitignore для ASP.NET Core проектов (Rider, Visual Studio, Visual Studio Code)

# --- Visual Studio / .NET ---
# Сборки
/bin/
obj/
artifacts/
out/
publish/

# NuGet
*.nupkg
packages/
project.lock.json
project.fragment.lock.json

# User-specific и временные файлы
*.user
*.userosscache
*.suo
*.sln.docstates
*.vcxproj.user
*.filters
*.dbmdl

# Visual Studio folder
.vs/

# Test results
TestResults/

# Publish/profiles
*.Publish.xml

# --- Rider (JetBrains) ---
.idea/
*.sln.iml
*.Rider*/   # иногда встречается

# ReSharper
_ReSharper*/
*.DotSettings.user

# --- Visual Studio Code ---
.vscode/

# --- Node / frontend (если есть SPA части) ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# --- Базы данных, локальные файлы ---
*.mdf
*.ldf
*.sqlite
*.db
*.db-shm
*.db-wal

# --- Системные файлы ---
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# --- Логи, временные артефакты ---
*.log
*.tmp
*.temp

# --- Сборочные/временные бинарники (не хранить в репозитории) ---
*.exe
*.dll
*.pdb
*.ilk
*.obj

# --- IDE / OS специфичные ---
*.class
*.jar

# --- Можно добавить по необходимости ---
# Если в проекте используются файлы с секретами / локальными настройками, добавьте их здесь, например:
# appsettings.Development.json
# secrets.json